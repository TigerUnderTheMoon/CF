\newlabel{tab:ranking-results}{{5}{33}{Step importance ranking results. Mean metrics across 200 traces (1,027 steps). Bootstrap CIs at 95\% (10k resamples). SC-FMA QP and Ridge are bolded. $\dagger $ indicates $p < 0.01$ vs.\ raw CIU (Wilcoxon signed-rank)}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Extended ablation study. $\Delta \rho $ is the change in mean Spearman $\rho $ from the full QP configuration ($\alpha =1.0$, $\beta =0.5$, $\gamma =0.2$, $\delta =0.1$, $\varepsilon =10^{-4}$). $p$-values are from one-sided Wilcoxon tests against the full QP. Effect size $r = Z/\sqrt  {N}$. Synergy $\checkmark  $ indicates statistically significant positive interaction ($p < 0.05$).}}{33}{table.6}\protected@file@percent }
\newlabel{tab:ablation-ext}{{6}{33}{Extended ablation study. $\Delta \rho $ is the change in mean Spearman $\rho $ from the full QP configuration ($\alpha =1.0$, $\beta =0.5$, $\gamma =0.2$, $\delta =0.1$, $\varepsilon =10^{-4}$). $p$-values are from one-sided Wilcoxon tests against the full QP. Effect size $r = Z/\sqrt {N}$. Synergy $\checkmark $ indicates statistically significant positive interaction ($p < 0.05$)}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Computational efficiency. Times are per-trace mean $\pm $ std over 40 test traces. Scaling column reports the exponent $p$ in the power-law fit $T(k) \propto k^p$ estimated over traces with $k = 3, 5, 8, 12, 20$ (generated for scaling analysis).}}{34}{table.7}\protected@file@percent }
\newlabel{tab:efficiency}{{7}{34}{Computational efficiency. Times are per-trace mean $\pm $ std over 40 test traces. Scaling column reports the exponent $p$ in the power-law fit $T(k) \propto k^p$ estimated over traces with $k = 3, 5, 8, 12, 20$ (generated for scaling analysis)}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Time and space complexity comparison. Theoretical complexity is the asymptotic worst-case bound in big-$\mathcal  {O}$ notation. Empirical scaling exponent $p$ is the power-law fit $T(k) \propto k^p$. Space complexity accounts for all retained data structures (graph adjacency, redundancy matrix, Hessian).}}{34}{table.8}\protected@file@percent }
\newlabel{tab:complexity}{{8}{34}{Time and space complexity comparison. Theoretical complexity is the asymptotic worst-case bound in big-$\mathcal {O}$ notation. Empirical scaling exponent $p$ is the power-law fit $T(k) \propto k^p$. Space complexity accounts for all retained data structures (graph adjacency, redundancy matrix, Hessian)}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Current positive real-data evidence and claim boundaries. PRM800K supports real step-label ranking and an in-distribution frozen PRM baseline context only. GSM8K/HotpotQA replay and downstream filtering remain failed or blocked provenance, not positive validation evidence.}}{34}{table.9}\protected@file@percent }
\newlabel{tab:prm800k-real-evidence}{{9}{34}{Current positive real-data evidence and claim boundaries. PRM800K supports real step-label ranking and an in-distribution frozen PRM baseline context only. GSM8K/HotpotQA replay and downstream filtering remain failed or blocked provenance, not positive validation evidence}{table.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Computational scaling curves. Wall-clock time $T(k)$ as a function of trace size $k$ (3--20 steps) on log-log axes. Each curve shows the power-law fit $T(k) \propto k^p$; the exponent $p$ and corresponding $\mathcal  {O}$ complexity class are annotated. SC-FMA QP follows the $\mathcal  {O}(k^3)$ theoretical bound, while Ridge and Projection scale near-linearly. Error bars indicate $\pm 1$ std. over 10 traces per size. Dashed lines show the power-law fits with $R^2 > 0.96$ for all methods.}}{35}{figure.3}\protected@file@percent }
\newlabel{fig:scaling}{{3}{35}{Computational scaling curves. Wall-clock time $T(k)$ as a function of trace size $k$ (3--20 steps) on log-log axes. Each curve shows the power-law fit $T(k) \propto k^p$; the exponent $p$ and corresponding $\mathcal {O}$ complexity class are annotated. SC-FMA QP follows the $\mathcal {O}(k^3)$ theoretical bound, while Ridge and Projection scale near-linearly. Error bars indicate $\pm 1$ std. over 10 traces per size. Dashed lines show the power-law fits with $R^2 > 0.96$ for all methods}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.10}{\ignorespaces Step importance ranking metrics stratified by trace size $k$. Mean Spearman $\rho $ over traces of each size. Standard errors in parentheses (bootstrap, 10k resamples).}}{35}{table.10}\protected@file@percent }
\newlabel{tab:per-size}{{B.10}{35}{Step importance ranking metrics stratified by trace size $k$. Mean Spearman $\rho $ over traces of each size. Standard errors in parentheses (bootstrap, 10k resamples)}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces Structural diagnostic summary by perturbation mode. The three perturbation modes (PRUNE, CASCADE, BYPASS) are compared on Pearson correlation, Spearman rank correlation, and zero-necessity fraction. Error bars indicate 95\% bootstrap confidence intervals. The consistency across modes confirms that weak CIU-necessity alignment is not an artifact of a single perturbation strategy.}}{36}{figure.4}\protected@file@percent }
\newlabel{fig:mode-comparison}{{B.4}{36}{Structural diagnostic summary by perturbation mode. The three perturbation modes (PRUNE, CASCADE, BYPASS) are compared on Pearson correlation, Spearman rank correlation, and zero-necessity fraction. Error bars indicate 95\% bootstrap confidence intervals. The consistency across modes confirms that weak CIU-necessity alignment is not an artifact of a single perturbation strategy}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces Redundancy density and compensation analysis. Panel (a): per-trace redundancy density distribution (mean $0.3842$). Panel (b): per-node compensation ratio distribution under PRUNE mode (median $0.000$, mean $0.0084$). The concentration of compensation at zero confirms that reflective reasoning traces exhibit limited structural redistribution: removing a node rarely increases the necessity of its downstream neighbors.}}{36}{figure.5}\protected@file@percent }
\newlabel{fig:redundancy-comp}{{B.5}{36}{Redundancy density and compensation analysis. Panel (a): per-trace redundancy density distribution (mean $0.3842$). Panel (b): per-node compensation ratio distribution under PRUNE mode (median $0.000$, mean $0.0084$). The concentration of compensation at zero confirms that reflective reasoning traces exhibit limited structural redistribution: removing a node rarely increases the necessity of its downstream neighbors}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {C.11}{\ignorespaces Cross-correlation between oracle components and SCU inputs across 1{,}027 steps. All correlations are below $|\rho | < 0.15$, confirming functional independence.}}{36}{table.11}\protected@file@percent }
\newlabel{tab:oracle-independence}{{C.11}{36}{Cross-correlation between oracle components and SCU inputs across 1{,}027 steps. All correlations are below $|\rho | < 0.15$, confirming functional independence}{table.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces Resilience curves under ordered node removal. Four removal orders are compared: necessity-first, attribution-first, sequential (original trace order), and deterministic random (hash-based). The $y$-axis shows remaining structural necessity fraction; the $x$-axis is the fraction of nodes removed. AUC values are annotated. The necessity-first curve degrades sharply (AUC $0.1488$), while attribution-first (AUC $0.4761$) is close to random (AUC $0.5098$), demonstrating that local CIU is not a sufficient proxy for structural criticality.}}{37}{figure.6}\protected@file@percent }
\newlabel{fig:resilience-app}{{B.6}{37}{Resilience curves under ordered node removal. Four removal orders are compared: necessity-first, attribution-first, sequential (original trace order), and deterministic random (hash-based). The $y$-axis shows remaining structural necessity fraction; the $x$-axis is the fraction of nodes removed. AUC values are annotated. The necessity-first curve degrades sharply (AUC $0.1488$), while attribution-first (AUC $0.4761$) is close to random (AUC $0.5098$), demonstrating that local CIU is not a sufficient proxy for structural criticality}{figure.6}{}}
