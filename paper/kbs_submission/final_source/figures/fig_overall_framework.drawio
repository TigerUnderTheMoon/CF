        <mxCell id="scu_math" value="\(\begin{aligned}\Omega &amp;= \{\tau_1,\ldots,\tau_K\}\\ \mathbf{w} &amp;= (w_1,\ldots,w_K)^\top\\ \mathbf{w}^* &amp;= \arg\min_{\mathbf{w}}\|\mathbf{w}-\mathbf{f}\|_2^2\\ \text{s.t.}\quad \sum_{i=1}^{K} w_i &amp;= 1,\; w_i \ge 0\end{aligned}\)" style="text=1;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=9;fontColor=#333333;fontStyle=0;spacing=0;shadow=0;" vertex="1" parent="g_scfma">
