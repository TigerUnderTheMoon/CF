\newlabel{tab:ranking-results}{{5}{32}{Step importance ranking results. Mean metrics across 200 traces (1,027 steps). Bootstrap CIs at 95\% (10k resamples). SC-FMA QP and Ridge are bolded. $\dagger $ indicates $p < 0.01$ vs.\ raw CIU (Wilcoxon signed-rank)}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Extended ablation study. $\Delta \rho $ is the change in mean Spearman $\rho $ from the full QP configuration ($\alpha =1.0$, $\beta =0.5$, $\gamma =0.2$, $\delta =0.1$, $\varepsilon =10^{-4}$). $p$-values are from one-sided Wilcoxon tests against the full QP. Effect size $r = Z/\sqrt  {N}$. Synergy $\checkmark  $ indicates statistically significant positive interaction ($p < 0.05$).}}{32}{table.6}\protected@file@percent }
\newlabel{tab:ablation-ext}{{6}{32}{Extended ablation study. $\Delta \rho $ is the change in mean Spearman $\rho $ from the full QP configuration ($\alpha =1.0$, $\beta =0.5$, $\gamma =0.2$, $\delta =0.1$, $\varepsilon =10^{-4}$). $p$-values are from one-sided Wilcoxon tests against the full QP. Effect size $r = Z/\sqrt {N}$. Synergy $\checkmark $ indicates statistically significant positive interaction ($p < 0.05$)}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Computational efficiency. Times are per-trace mean $\pm $ std over 40 test traces. Scaling column reports the exponent $p$ in the power-law fit $T(k) \propto k^p$ estimated over traces with $k = 3, 5, 8, 12, 20$ (generated for scaling analysis).}}{33}{table.7}\protected@file@percent }
\newlabel{tab:efficiency}{{7}{33}{Computational efficiency. Times are per-trace mean $\pm $ std over 40 test traces. Scaling column reports the exponent $p$ in the power-law fit $T(k) \propto k^p$ estimated over traces with $k = 3, 5, 8, 12, 20$ (generated for scaling analysis)}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Time and space complexity comparison. Theoretical complexity is the asymptotic worst-case bound in big-$\mathcal  {O}$ notation. Empirical scaling exponent $p$ is the power-law fit $T(k) \propto k^p$. Space complexity accounts for all retained data structures (graph adjacency, redundancy matrix, Hessian).}}{33}{table.8}\protected@file@percent }
\newlabel{tab:complexity}{{8}{33}{Time and space complexity comparison. Theoretical complexity is the asymptotic worst-case bound in big-$\mathcal {O}$ notation. Empirical scaling exponent $p$ is the power-law fit $T(k) \propto k^p$. Space complexity accounts for all retained data structures (graph adjacency, redundancy matrix, Hessian)}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Computational scaling curves. Wall-clock time $T(k)$ as a function of trace size $k$ (3--20 steps) on log-log axes. Each curve shows the power-law fit $T(k) \propto k^p$; the exponent $p$ and corresponding $\mathcal  {O}$ complexity class are annotated. SC-FMA QP follows the $\mathcal  {O}(k^3)$ theoretical bound, while Ridge and Projection scale near-linearly. Error bars indicate $\pm 1$ std. over 10 traces per size. Dashed lines show the power-law fits with $R^2 > 0.96$ for all methods.}}{34}{figure.3}\protected@file@percent }
\newlabel{fig:scaling}{{3}{34}{Computational scaling curves. Wall-clock time $T(k)$ as a function of trace size $k$ (3--20 steps) on log-log axes. Each curve shows the power-law fit $T(k) \propto k^p$; the exponent $p$ and corresponding $\mathcal {O}$ complexity class are annotated. SC-FMA QP follows the $\mathcal {O}(k^3)$ theoretical bound, while Ridge and Projection scale near-linearly. Error bars indicate $\pm 1$ std. over 10 traces per size. Dashed lines show the power-law fits with $R^2 > 0.96$ for all methods}{figure.3}{}}
