# Python artifacts
__pycache__/
*.py[cod]
.coverage*
.pytest_cache/
.env
.venv/
.env

# DVC-tracked directories (contents via DVC, .dvc files via Git)
data/
!data.dvc
outputs/**
!outputs/*.dvc

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# DVC cache & tmp (never commit)
.dvc/cache/
.dvc/tmp/

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.abs
*.bbl
*.blg
*.toc
*.synctex.gz
$out/

# Lock files (optional, depending on team preference)
# poetry.lock
# pdm.lock
/data

# Local paper manuscripts and submission materials
/paper/*
!/paper/JIIS_submission/
/paper/JIIS_submission/*
!/paper/JIIS_submission/reproducibility_manifest.md
!/paper/JIIS_submission/submission_package/
/paper/JIIS_submission/submission_package/*
!/paper/JIIS_submission/submission_package/reproducibility_archive.zip
